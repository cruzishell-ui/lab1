#include <iostream>
#include <iomanip>
using namespace std;

// Function prototypes
void menu();

void recordSale(double &total, int &transactions,
                double &highest, double &lowest,
                double &grocery, double &beverages,
                double &merchandise, int &gCount,
                int &bCount, int &mCount);

void report(double total, int transactions,
            double highest, double lowest,
            double grocery, double beverages,
            double merchandise, int gCount,
            int bCount, int mCount);

// Menu function
void menu() {
    cout << "\n=====================================================\n";
    cout << "      BELIZE TRADING CO. - DAILY SALES ANALYZER\n";
    cout << "=====================================================\n";
    cout << "Shift Location: San Ignacio Branch\n";
    cout << "Currency: Belize Dollars (BZ$)\n\n";

    cout << "MAIN MENU:\n";
    cout << "1. Record a New Sale Transaction\n";
    cout << "2. View Shift Snapshot\n";
    cout << "3. Close Shift and Print Daily Audit\n";
    cout << "4. Exit Without Saving\n";
}

// Main function
int main() {
    int choice;
    int transactions = 0;
    int gCount = 0, bCount = 0, mCount = 0;

    double total = 0;
    double highest = 0, lowest = 0;
    double grocery = 0, beverages = 0, merchandise = 0;

    cout << fixed << setprecision(2);

    do {
        menu();

        cout << "Enter choice (1-4): ";
        cin >> choice;

        while (choice < 1 || choice > 4) {
            cout << "Invalid choice. Enter 1-4: ";
            cin >> choice;
        }

        if (choice == 1) {
            recordSale(total, transactions, highest, lowest,
                       grocery, beverages, merchandise,
                       gCount, bCount, mCount);
        }
        else if (choice == 2) {
            report(total, transactions, highest, lowest,
                   grocery, beverages, merchandise,
                   gCount, bCount, mCount);
        }
        else if (choice == 3) {
            report(total, transactions, highest, lowest,
                   grocery, beverages, merchandise,
                   gCount, bCount, mCount);

            if (transactions > 0) {
                cout << "Shift reconciliation completed successfully.\n";
            }

            cout << "Have a safe evening!\n";
        }
        else {
            cout << "Exiting without saving. Goodbye!\n";
        }

    } while (choice != 3 && choice != 4);

    return 0;
}

// Function to record sales
void recordSale(double &total, int &transactions,
                double &highest, double &lowest,
                double &grocery, double &beverages,
                double &merchandise, int &gCount,
                int &bCount, int &mCount) {

    double sale;
    int category;
    char answer;

    do {
        cout << "\n--- Record Sale #" << transactions + 1 << " ---\n";
        cout << "Enter sale amount ($BZ): ";
        cin >> sale;

        while (sale <= 0) {
            cout << "[ERROR] Invalid entry! Sale amount must be greater than $BZ 0.00.\n";
            cout << "Enter sale amount ($BZ): ";
            cin >> sale;
        }

        cout << "\nSelect Category:\n";
        cout << "[1] Grocery & Produce\n";
        cout << "[2] Beverages & Snacks\n";
        cout << "[3] General Merchandise\n";
        cout << "Enter category choice (1-3): ";
        cin >> category;

        while (category < 1 || category > 3) {
            cout << "Invalid category. Enter 1, 2, or 3: ";
            cin >> category;
        }

        total = total + sale;
        transactions++;

        if (transactions == 1) {
            highest = sale;
            lowest = sale;
        }
        else {
            if (sale > highest) {
                highest = sale;
            }

            if (sale < lowest) {
                lowest = sale;
            }
        }

        if (category == 1) {
            grocery = grocery + sale;
            gCount++;
            cout << "Sale of $BZ " << sale
                 << " recorded under Grocery & Produce.\n";
        }
        else if (category == 2) {
            beverages = beverages + sale;
            bCount++;
            cout << "Sale of $BZ " << sale
                 << " recorded under Beverages & Snacks.\n";
        }
        else {
            merchandise = merchandise + sale;
            mCount++;
            cout << "Sale of $BZ " << sale
                 << " recorded under General Merchandise.\n";
        }

        cout << "\nDo you want to enter another transaction? (y/n): ";
        cin >> answer;

    } while (answer == 'y' || answer == 'Y');

    cout << "\nReturning to Main Menu...\n";
}

// Function to print the report
void report(double total, int transactions,
            double highest, double lowest,
            double grocery, double beverages,
            double merchandise, int gCount,
            int bCount, int mCount) {

    cout << "\n=====================================================\n";
    cout << "          END-OF-DAY SALES AUDIT REPORT\n";
    cout << "=====================================================\n";

    if (transactions == 0) {
        cout << "No transactions recorded today.\n";
        cout << "=====================================================\n";
        return;
    }

    cout << "Total Transactions Processed: " << transactions << endl;
    cout << "Gross Revenue Collected:      $BZ " << total << endl;
    cout << "Average Transaction Size:     $BZ "
         << total / transactions << endl;

    cout << "-----------------------------------------------------\n";
    cout << "Peak Transaction (Highest):   $BZ " << highest << endl;
    cout << "Base Transaction (Lowest):    $BZ " << lowest << endl;

    cout << "=====================================================\n";
    cout << "               CATEGORY BREAKDOWN\n";
    cout << "=====================================================\n";

    cout << left << setw(25) << "Category"
         << right << setw(7) << "Count"
         << setw(14) << "Subtotal"
         << setw(10) << "Share" << endl;

    cout << "-----------------------------------------------------\n";

    cout << left << setw(25) << "Grocery & Produce"
         << right << setw(7) << gCount
         << "   $BZ " << setw(7) << grocery
         << setw(8) << grocery / total * 100 << "%" << endl;

    cout << left << setw(25) << "Beverages & Snacks"
         << right << setw(7) << bCount
         << "   $BZ " << setw(7) << beverages
         << setw(8) << beverages / total * 100 << "%" << endl;

    cout << left << setw(25) << "General Merchandise"
         << right << setw(7) << mCount
         << "   $BZ " << setw(7) << merchandise
         << setw(8) << merchandise / total * 100 << "%" << endl;

    cout << "=====================================================\n";
}
